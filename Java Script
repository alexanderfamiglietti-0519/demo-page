/* ==========================================================================
   NFL Stadium Arcade Engine - script.js
   ========================================================================== */

document.addEventListener('DOMContentLoaded', () => {

  // ------------------------------------------------------------------------
  // 1. MINI-GAME 1: Field Goal Kicker
  // ------------------------------------------------------------------------
  let fgScore = 0;
  let fgAttempts = 5;
  let needlePosition = 0;
  let needleDirection = 1;
  let needleInterval = null;
  let isNeedleMoving = false;

  const aimNeedle = document.getElementById('aim-needle');
  const kickBall = document.getElementById('kick-ball');
  const btnKick = document.getElementById('btn-kick');
  const fgScoreEl = document.getElementById('fg-score');
  const fgAttemptsEl = document.getElementById('fg-attempts');
  const cowboysScoreEl = document.getElementById('cowboys-score');
  const gameStatusEl = document.getElementById('game-status');

  function startNeedle() {
    if (isNeedleMoving) return;
    isNeedleMoving = true;
    needleInterval = setInterval(() => {
      needlePosition += 2.2 * needleDirection;
      if (needlePosition >= 100) {
        needlePosition = 100;
        needleDirection = -1;
      } else if (needlePosition <= 0) {
        needlePosition = 0;
        needleDirection = 1;
      }
      if (aimNeedle) aimNeedle.style.left = `${needlePosition}%`;
    }, 16);
  }

  // Start oscillating aim bar on load
  startNeedle();

  if (btnKick) {
    btnKick.addEventListener('click', () => {
      if (fgAttempts <= 0) {
        resetFieldGoalGame();
        return;
      }

      if (!isNeedleMoving) return;

      clearInterval(needleInterval);
      isNeedleMoving = false;
      fgAttempts--;
      if (fgAttemptsEl) fgAttemptsEl.textContent = fgAttempts;

      // Target zone is between 40% and 60%
      if (needlePosition >= 40 && needlePosition <= 60) {
        fgScore += 3;
        if (fgScoreEl) fgScoreEl.textContent = fgScore;
        
        // Add 3 points to Cowboys scoreboard
        if (cowboysScoreEl) {
          const currentScore = parseInt(cowboysScoreEl.textContent, 10) || 0;
          cowboysScoreEl.textContent = currentScore + 3;
          triggerScoreGlow(cowboysScoreEl);
        }

        if (gameStatusEl) gameStatusEl.textContent = "FIELD GOAL IS GOOD! (+3)";
        animateBall(true);
      } else {
        if (gameStatusEl) gameStatusEl.textContent = "KICK NO GOOD! NO POINTS";
        animateBall(false);
      }

      setTimeout(() => {
        if (fgAttempts > 0) {
          resetBallPosition();
          startNeedle();
        } else {
          if (btnKick) btnKick.textContent = "PLAY AGAIN";
          if (gameStatusEl) gameStatusEl.textContent = `FINAL KICK SCORE: ${fgScore} PTS`;
        }
      }, 1200);
    });
  }

  function animateBall(isSuccess) {
    if (!kickBall) return;
    if (isSuccess) {
      kickBall.style.transform = "translateY(-140px) scale(0.4)";
    } else {
      const xDir = needlePosition < 40 ? '-120px' : '120px';
      kickBall.style.transform = `translate(${xDir}, -100px) scale(0.4) rotate(60deg)`;
    }
  }

  function resetBallPosition() {
    if (kickBall) kickBall.style.transform = "none";
  }

  function resetFieldGoalGame() {
    fgScore = 0;
    fgAttempts = 5;
    if (fgScoreEl) fgScoreEl.textContent = fgScore;
    if (fgAttemptsEl) fgAttemptsEl.textContent = fgAttempts;
    if (btnKick) btnKick.textContent = "KICK FIELD GOAL";
    if (gameStatusEl) gameStatusEl.textContent = "FIELD GOAL CHALLENGE READY";
    resetBallPosition();
    startNeedle();
  }

  // ------------------------------------------------------------------------
  // 2. MINI-GAME 2: QB Target Pass Challenge
  // ------------------------------------------------------------------------
  let qbScore = 0;
  let qbTimeLeft = 15;
  let qbTimerInterval = null;
  let isGameActive = false;

  const btnStartQb = document.getElementById('btn-start-qb');
  const targetReceiver = document.getElementById('target-receiver');
  const qbArena = document.getElementById('qb-arena');
  const qbScoreEl = document.getElementById('qb-score');
  const qbTimerEl = document.getElementById('qb-timer');
  const qbStartMsg = document.getElementById('qb-start-msg');

  if (btnStartQb) {
    btnStartQb.addEventListener('click', () => {
      if (isGameActive) return;
      startQBGame();
    });
  }

  function startQBGame() {
    qbScore = 0;
    qbTimeLeft = 15;
    isGameActive = true;

    if (qbScoreEl) qbScoreEl.textContent = qbScore;
    if (qbTimerEl) qbTimerEl.textContent = `${qbTimeLeft}s`;
    if (qbStartMsg) qbStartMsg.style.display = 'none';
    if (btnStartQb) btnStartQb.disabled = true;
    if (gameStatusEl) gameStatusEl.textContent = "QB TARGET PASS IN PROGRESS...";

    moveTarget();

    qbTimerInterval = setInterval(() => {
      qbTimeLeft--;
      if (qbTimerEl) qbTimerEl.textContent = `${qbTimeLeft}s`;

      if (qbTimeLeft <= 0) {
        endQBGame();
      }
    }, 1000);
  }

  function moveTarget() {
    if (!isGameActive || !targetReceiver || !qbArena) return;

    const arenaWidth = qbArena.clientWidth - 70;
    const arenaHeight = qbArena.clientHeight - 70;

    const randomX = Math.max(10, Math.floor(Math.random() * arenaWidth));
    const randomY = Math.max(10, Math.floor(Math.random() * arenaHeight));

    targetReceiver.style.left = `${randomX}px`;
    targetReceiver.style.top = `${randomY}px`;
    targetReceiver.style.display = 'block';
  }

  if (targetReceiver) {
    targetReceiver.addEventListener('click', () => {
      if (!isGameActive) return;
      qbScore += 10;
      if (qbScoreEl) qbScoreEl.textContent = qbScore;
      moveTarget();
    });
  }

  function endQBGame() {
    clearInterval(qbTimerInterval);
    isGameActive = false;

    if (targetReceiver) targetReceiver.style.display = 'none';
    if (qbStartMsg) {
      qbStartMsg.textContent = `TIME'S UP! FINAL SCORE: ${qbScore} PTS`;
      qbStartMsg.style.display = 'block';
    }
    if (btnStartQb) {
      btnStartQb.disabled = false;
      btnStartQb.textContent = "PLAY AGAIN";
    }
    if (gameStatusEl) gameStatusEl.textContent = `QB CHALLENGE FINISHED (${qbScore} PTS)`;
  }

  // Smooth scrolling for navigation links
  const navLinks = document.querySelectorAll('.nav-link');
  navLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      const targetId = link.getAttribute('href');
      if (targetId && targetId.startsWith('#')) {
        e.preventDefault();
        navLinks.forEach(l => l.classList.remove('active'));
        link.classList.add('active');
        document.querySelector(targetId)?.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });

  // Scoreboard glow visual feedback
  function triggerScoreGlow(element) {
    element.style.color = '#ffffff';
    element.style.textShadow = '0 0 20px #00f0ff, 0 0 30px #00f0ff';
    setTimeout(() => {
      element.style.color = '#00f0ff';
      element.style.textShadow = '0 0 10px #00f0ff';
    }, 800);
  }

});
