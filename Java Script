/* ==========================================================================
   NFL Stadium Arcade Engine - script.js
   ========================================================================== */

document.addEventListener('DOMContentLoaded', () => {

  // ------------------------------------------------------------------------
  // 1. MINI-GAME 1: Field Goal Kicker
  // ------------------------------------------------------------------------
  let fgScore = 0;
  let fgAttempts = 5;
  let needlePosition = 0;
  let needleDirection = 1;
  let needleInterval = null;
  let isNeedleMoving = false;

  const aimNeedle = document.getElementById('aim-needle');
  const kickBall = document.getElementById('kick-ball');
  const btnKick = document.getElementById('btn-kick');
  const fgScoreEl = document.getElementById('fg-score');
  const fgAttemptsEl = document.getElementById('fg-attempts');

  function startNeedle() {
    if (isNeedleMoving) return;
    isNeedleMoving = true;
    needleInterval = setInterval(() => {
      needlePosition += 2 * needleDirection;
      if (needlePosition >= 100) {
        needlePosition = 100;
        needleDirection = -1;
      } else if (needlePosition <= 0) {
        needlePosition = 0;
        needleDirection = 1;
      }
      if (aimNeedle) aimNeedle.style.left = `${needlePosition}%`;
    }, 16);
  }

  startNeedle();

  if (btnKick) {
    btnKick.addEventListener('click', () => {
      if (fgAttempts <= 0) {
        resetFieldGoalGame();
        return;
      }

      if (!isNeedleMoving) return;

      clearInterval(needleInterval);
      isNeedleMoving = false;
      fgAttempts--;
      if (fgAttemptsEl) fgAttemptsEl.textContent = fgAttempts;

      // Target zone is between 40% and 60%
      if (needlePosition >= 40 && needlePosition <= 60) {
        fgScore += 3;
        if (fgScoreEl) fgScoreEl.textContent = fgScore;
        animateBall(true);
      } else {
        animateBall(false);
      }

      setTimeout(() => {
        if (fgAttempts > 0) {
          resetBallPosition();
          startNeedle();
        } else {
          if (btnKick) btnKick.textContent = "PLAY AGAIN";
        }
      }, 1200);
    });
  }

  function animateBall(isSuccess) {
    if (!kickBall) return;
    if (isSuccess) {
      kickBall.style.transform = "translateY(-140px) scale(0.5)";
    } else {
      kickBall.style.transform = `translate(${needlePosition < 40 ? '-100px' : '100px'}, -100px) scale(0.5) rotate(45deg)`;
    }
  }

  function resetBallPosition() {
    if (kickBall) kickBall.style.transform = "none";
  }

  function resetFieldGoalGame() {
    fgScore = 0;
    fgAttempts = 5;
    if (fgScoreEl) fgScoreEl.textContent = fgScore;
    if (fgAttemptsEl) fgAttemptsEl.textContent = fgAttempts;
    if (btnKick) btnKick.textContent = "KICK FIELD GOAL";
    resetBallPosition();
    startNeedle();
  }

  // ------------------------------------------------------------------------
  // 2. MINI-GAME 2: QB Target Pass Challenge
  // ------------------------------------------------------------------------
  let qbScore = 0;
  let qbTimeLeft = 15;
  let qbTimerInterval = null;
  let isGameActive = false;

  const btnStartQb = document.getElementById('btn-start-qb');
  const targetReceiver = document.getElementById('target-receiver');
  const qbArena = document.getElementById('qb-arena');
  const qbScoreEl = document.getElementById('qb-score');
  const qbTimerEl = document.getElementById('qb-timer');
  const qbStartMsg = document.getElementById('qb-start-msg');

  if (btnStartQb) {
    btnStartQb.addEventListener('click', () => {
      if (isGameActive) return;
      startQBGame();
    });
  }

  function startQBGame() {
    qbScore = 0;
    qbTimeLeft = 15;
    isGameActive = true;

    if (qbScoreEl) qbScoreEl.textContent = qbScore;
    if (qbTimerEl) qbTimerEl.textContent = `${qbTimeLeft}s`;
    if (qbStartMsg) qbStartMsg.style.display = 'none';
    if (btnStartQb) btnStartQb.disabled = true;

    moveTarget();

    qbTimerInterval = setInterval(() => {
      qbTimeLeft--;
      if (qbTimerEl) qbTimerEl.textContent = `${qbTimeLeft}s`;

      if (qbTimeLeft <= 0) {
        endQBGame();
      }
    }, 1000);
  }

  function moveTarget() {
    if (!isGameActive || !targetReceiver || !qbArena) return;

    const arenaWidth = qbArena.clientWidth - 60;
    const arenaHeight = qbArena.clientHeight - 60;

    const randomX = Math.floor(Math.random() * arenaWidth);
    const randomY = Math.floor(Math.random() * arenaHeight);

    targetReceiver.style.left = `${randomX}px`;
    targetReceiver.style.top = `${randomY}px`;
    targetReceiver.style.display = 'block';
  }

  if (targetReceiver) {
    targetReceiver.addEventListener('click', () => {
      if (!isGameActive) return;
      qbScore += 10;
      if (qbScoreEl) qbScoreEl.textContent = qbScore;
      moveTarget();
    });
  }

  function endQBGame() {
    clearInterval(qbTimerInterval);
    isGameActive = false;

    if (targetReceiver) targetReceiver.style.display = 'none';
    if (qbStartMsg) {
      qbStartMsg.textContent = `TIME'S UP! FINAL SCORE: ${qbScore}`;
      qbStartMsg.style.display = 'block';
    }
    if (btnStartQb) {
      btnStartQb.disabled = false;
      btnStartQb.textContent = "PLAY AGAIN";
    }
  }

});
